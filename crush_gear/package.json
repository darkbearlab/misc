{
  "name": "crush-gear-sim",
  "version": "0.1.0",
  "private": true,
  "description": "Phase 0 headless deterministic physics core for the Crush Gear battle-car simulator.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "sim": "tsx tools/sim.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.19.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  }
}
